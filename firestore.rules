rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /activities/{document=**} {
      allow read, write: if true;
    }
    match /employees/{document=**} {
      allow read, write: if true;
    }
    match /commitments/{document=**} {
      allow read, write: if true;
    }
  }
}
